# User configuration files (not tracked in git)
/orbstack-nix-config/extra/*.nix

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Nix
/result
/result-*
/.nix/venv

# VM flake.lock is generated by Nix and user-specific
/orbstack-nix-config/flake.lock

# Project-scope skill installs from `nix develop`'s startup hook; the
# skills' preferences files beside them are the project's own.
/.agents/skills/*
!/.agents/skills/*.preferences.md
/.claude/skills
